# Copy this file to .env and fill in real values locally.
# NEVER commit the actual .env file.

# --- General & Observability ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- Database ---
# Local dev default matches docker-compose.yml. Override for other environments.
DATABASE_URL=postgresql://recoverai:recoverai@localhost:5432/recoverai

# --- AI Recommendation Engine ---
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- Razorpay Payments & Webhooks ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Communication Providers (Optional - Mocks used by default) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@recoverai.example

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Webhooks & Execution Jobs ---
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_ALLOW_INSECURE_HTTP=false
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=30

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Demo & Buildathon Mode ---
DEMO_MODE=true
DEMO_SEED=42
