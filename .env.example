# Copy this file to .env and fill in real values locally.
# NEVER commit the actual .env file.

# --- General ---
ENVIRONMENT=development

# --- Database ---
# Local dev default matches docker-compose.yml. Override for other environments.
DATABASE_URL=postgresql://recoverai:recoverai@localhost:5432/recoverai

# --- AI (Gemini) --- used starting a later milestone
GEMINI_API_KEY=

# --- Razorpay --- used starting a later milestone
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend / CORS ---
FRONTEND_ORIGIN=http://localhost:5173
